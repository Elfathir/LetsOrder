APP_NAME=LetsOrder
# Production deployment checklist: set APP_ENV=production, APP_DEBUG=false,
# LOG_LEVEL=warning, PAYMENT_SIMULATION_ENABLED=false, and run php artisan key:generate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Token & sesi berakhir otomatis hanya jika pengguna tidak membuka aplikasi selama N hari (default 5 hari)
SESSION_INACTIVITY_DAYS=5
PAYMENT_SIMULATION_ENABLED=true

# MySQL database connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=letsorder
DB_USERNAME=root
DB_PASSWORD=

# Session and cache defaults; adjust to the Laravel skeleton/configuration used.
SESSION_DRIVER=file
SESSION_LIFETIME=7200
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Frontend origin for local development.
FRONTEND_URL=http://localhost:5173
