APP_NAME=LetsOrder
# Production deployment checklist: set APP_ENV=production, APP_DEBUG=false,
# LOG_LEVEL=warning, PAYMENT_SIMULATION_ENABLED=false, and run php artisan key:generate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug
# Optional: set positive minutes (e.g. 1440) to expire Sanctum API tokens automatically
# SANCTUM_TOKEN_EXPIRATION=1440
PAYMENT_SIMULATION_ENABLED=true

# MySQL database connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=letsorder
DB_USERNAME=root
DB_PASSWORD=

# Session and cache defaults; adjust to the Laravel skeleton/configuration used.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Frontend origin for local development.
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
