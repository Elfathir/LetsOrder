          "name": "Buat Pembayaran Simulasi (QRIS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id_pembayaran) {",
                  "    pm.collectionVariables.set('payment_id', jsonData.data.id_pembayaran);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metode_pembayaran\": \"QRIS\"\n}"
            },
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/payment", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "payment"] }
          }
        },
        {
          "name": "Informasi Pembayaran Pesanan",
