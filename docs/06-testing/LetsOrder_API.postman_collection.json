          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/menus?status_tersedia=1",
              "host": ["{{base_url}}"],
              "path": ["menus"],
