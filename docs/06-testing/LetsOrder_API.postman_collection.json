            "url": { "raw": "{{base_url}}/cart/items", "host": ["{{base_url}}"], "path": ["cart", "items"] }
          }
        },
        {
          "name": "Ubah Jumlah / Catatan Item Keranjang",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jumlah\": 3,\n  \"catatan\": \"Sambal bawang sedikit saja\"\n}"
            },
            "url": { "raw": "{{base_url}}/cart/items/1", "host": ["{{base_url}}"], "path": ["cart", "items", "1"] }
          }
        },
        {
          "name": "Hapus Item dari Keranjang",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "url": { "raw": "{{base_url}}/cart/items/1", "host": ["{{base_url}}"], "path": ["cart", "items", "1"] }
          }
        },
        {
          "name": "Kosongkan Keranjang",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "url": { "raw": "{{base_url}}/cart", "host": ["{{base_url}}"], "path": ["cart"] }
          }
        }
      ]
    },
    {
      "name": "6. Pemesanan & Pelacakan Self-Pickup",
      "item": [
        {
          "name": "Buat Pesanan dari Keranjang",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id_pesanan) {",
                  "    pm.collectionVariables.set('order_id', jsonData.data.id_pesanan);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catatan\": \"Diambil jam 12:15 WIB\"\n}"
            },
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Daftar Riwayat Pesanan Customer",
