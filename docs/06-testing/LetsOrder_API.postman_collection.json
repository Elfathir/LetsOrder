            ],
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/payment", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "payment"] }
          }
        },
        {
          "name": "Verifikasi Pembayaran Simulasi (Status -> Sedang Diproses)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_customer}}" }
            ],
            "body": {
              "mode": "raw",
