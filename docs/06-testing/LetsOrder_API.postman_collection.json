{
  "info": {
    "_postman_id": "c71a39f0-e41b-4bfa-a83d-3b8e762c5b9f",
    "name": "LetsOrder.com API Collection",
    "description": "Koleksi lengkap Postman API LetsOrder.com untuk pengujian seluruh alur Customer, Vendor, dan Administrator sesuai ERD final dan spesifikasi REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token_customer", "value": "", "type": "string" },
    { "key": "token_vendor", "value": "", "type": "string" },
    { "key": "token_admin", "value": "", "type": "string" },
    { "key": "order_id", "value": "1", "type": "string" },
    { "key": "payment_id", "value": "1", "type": "string" },
    { "key": "menu_id", "value": "1", "type": "string" },
    { "key": "tenant_id", "value": "1", "type": "string" }
